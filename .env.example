# ==========================================
# PaisaPilot Environment Configuration Template
# ==========================================
# WARNING: NEVER commit actual secrets, API keys, or database credentials.
# Duplicate this file as .env.local for local development.

# Application Environment
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database (MongoDB Atlas)
MONGODB_URI=your_mongodb_connection_string_here


# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_long_random_auth_secret_here

# AI Service (Google Gemini API - Copilot Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# Private Object Storage (Statements)
PRIVATE_STORAGE_BUCKET=paisapilot-statements-private

