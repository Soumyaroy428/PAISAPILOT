# ==========================================
# PaisaPilot Environment Configuration Template
# ==========================================
# WARNING: NEVER commit actual secrets, API keys, or database credentials.
# Duplicate this file as .env.local for local development.

# Application Environment
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/paisapilot?retryWrites=true&w=majority

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_long_random_auth_secret_here

# AI Service (Structured output & tool calling)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here

# Private Object Storage (Statements)
PRIVATE_STORAGE_BUCKET=paisapilot-statements-private

